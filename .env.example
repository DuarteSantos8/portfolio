# Copy to .env and fill in real values. .env is gitignored.

# Client build-time vars — inlined into the public bundle (safe to expose).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Server-only secrets — read at runtime by server/index.js. NEVER prefix with VITE_
# (that would leak them into the browser bundle). In production these come from the
# OKD/k8s secret `spotify-credentials`, not this file.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
